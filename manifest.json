{
  "manifest_version": 3,
  "name": "CazaPDF",
  "description": "Find and download PDFs loaded by web viewers such as Wuolah.",
  "version": "1.2.0",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "CazaPDF — Find PDFs on this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
